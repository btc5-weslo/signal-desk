# caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
__pycache__/
*.pyc
*.egg-info/
src/signal_data.egg-info/
.python-version

# virtualenvs (local and nested)
.venv/
venv/
.env/
**/.venv/
**/venv/

# build artifacts
dist/
build/

# store data files (regenerated by explicit ingestion). keep directory placeholders.
store/**/*.parquet
store/**/*.tmp*
store/**/*.parquet.tmp*
catalog/*.duckdb
catalog/*.duckdb.wal
catalog/*.tmp*
tracker/*.parquet
tracker/*.tmp*

# Binance Vision zip cache (regenerated by ingest)
vision_cache/

# staging backfills (merged into store in a separate step)
staging/**/*.parquet
staging/**/*.tmp*
# local snapshots / venue backups
snapshots/
backups/
